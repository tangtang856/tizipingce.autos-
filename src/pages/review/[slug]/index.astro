---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import RelatedArticles from '@/components/RelatedArticles.astro';
import ArticleNavigation from '@/components/ArticleNavigation.astro';
import { getAllAirports, type Airport } from '@/data/airports';

export function getStaticPaths() {
  const airports = getAllAirports();
  return airports.map((airport, index) => {
    const prevAirport = index > 0 ? {
      title: `${airports[index - 1].name} 深度独立评测`,
      href: `/review/${airports[index - 1].slug}/`,
      category: airports[index - 1].lineType,
    } : null;

    const nextAirport = index < airports.length - 1 ? {
      title: `${airports[index + 1].name} 深度独立评测`,
      href: `/review/${airports[index + 1].slug}/`,
      category: airports[index + 1].lineType,
    } : null;

    return {
      params: { slug: airport.slug },
      props: { airport, prevAirport, nextAirport },
    };
  });
}

interface Props {
  airport: Airport;
  prevAirport: any;
  nextAirport: any;
}

const { airport, prevAirport, nextAirport } = Astro.props;

const pageTitle = airport.seo?.reviewTitle || `${airport.name} 深度评测报告 2026 | 晚高峰测速、专线稳定性与套餐优缺点 - 梯子评测网`;
const pageDescription = airport.seo?.reviewDescription || `2026最新 ${airport.name} 真实独立评测报告。实测晚高峰延迟、丢包率与 4K 秒开速度，深度解析套餐资费、节点线路、AI与流媒体解锁能力，提供客观购买建议。`;
const pageKeywords = airport.seo?.reviewKeywords || `${airport.name}, ${airport.name}评测, ${airport.name}怎么样, ${airport.name}官网, 梯子推荐, 机场节点, 科学上网`;

const breadcrumbs = [
  { label: '独立评测', href: '/review/' },
  { label: `${airport.name} 评测`, href: `/review/${airport.slug}/` },
];

const faqItems = [
  {
    question: `${airport.name} 的线路在敏感时期表现如何？`,
    answer: `${airport.name} 采用 ${airport.lineType}。在实测历次网络波动中，其专线节点保持了良好的连通率。相比普通公网中继，断流发生概率明显偏低。`,
  },
  {
    question: `购买 ${airport.name} 后如何快速配置到手机和电脑？`,
    answer: `登录 ${airport.name} 用户中心，在仪表盘点击“一键导入订阅”，选择您所使用的客户端（如 Windows 上的 Clash Verge、Mac 上的 Clash Verge Rev、iOS 上的 Shadowrocket 或 Android 上的 Surfboard）即可秒级载入所有节点。`,
  },
  {
    question: `${airport.name} 是否提供退款政策？`,
    answer: `根据官方公开的服务条款，该服务商通常在购买后 24 小时内且使用流量低于规定额度时支持工单沟通。具体退款准则请以官方控制台最新政策为准，建议初次以单月月付尝鲜。`,
  },
  {
    question: `${airport.name} 是否限制同时在线设备数量？`,
    answer: `${airport.name} 的在线设备规则为：${airport.deviceLimit || '支持多台设备同时并发在线'}。如需全家多设备同时出海，可在软路由端部署或选购高阶套餐。`,
  },
];

const relatedLinks = [
  { title: `${airport.name} 官方参数详细档案库`, href: `/airport/${airport.slug}/`, category: '品牌档案' },
  { title: '2026全网综合实力排行榜', href: '/ranking/overall/', category: '权威排行' },
  { title: '高性价比机场排行榜', href: '/ranking/value/', category: '排行榜' },
  { title: '多品牌同屏横向对比工具', href: '/compare/', category: '在线工具' },
];

// Schema for Review
const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  name: `${airport.name} 深度独立评测报告`,
  reviewBody: airport.description,
  datePublished: '2026-01-10',
  dateModified: airport.lastVerified || '2026-03-25',
  author: {
    '@type': 'Organization',
    name: '梯子评测网编辑团队',
  },
  itemReviewed: {
    '@type': 'Product',
    name: airport.name,
    description: airport.description,
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: airport.currency || 'CNY',
      lowPrice: airport.startingPrice || 15,
    },
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: airport.ratingScore,
    bestRating: 10,
    worstRating: 1,
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout title={pageTitle} description={pageDescription} keywords={pageKeywords} ogType="article" schema={[reviewSchema, faqSchema]}>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <article class="max-w-prose mx-auto">
      <!-- Article Header -->
      <header class="mb-10 pb-8 border-b border-slate-200">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-50 text-brand-700">
            {airport.lineType}
          </span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
            ✓ 站长亲自实测 · 真实抓包一手数据
          </span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-800">
            🔥 专属优惠价永久有效
          </span>
          <span class="text-xs text-slate-400">核验日期：{airport.lastVerified}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4 leading-tight">
          {airport.name} 深度独立评测：网络表现、资费与真实优缺点全面解析
        </h1>

        <!-- One sentence verdict box -->
        <div class="p-5 rounded-2xl bg-brand-50/70 border border-brand-200 text-slate-800 mb-6">
          <div class="text-xs font-bold uppercase tracking-wider text-brand-700 mb-1 flex items-center gap-1.5">
            <span>⚡ 一句话实测结论</span>
            <span class="text-xs px-2 py-0.2 rounded bg-amber-400 text-slate-900 font-extrabold">综合评分 {airport.ratingScore} / 10</span>
          </div>
          <p class="text-sm sm:text-base font-medium leading-relaxed">
            {airport.tagline}。适合 {airport.suitableFor.join('、')}。
          </p>
        </div>

        <!-- Telemetry Performance Dashboard -->
        {
          airport.speedTestReport && (
            <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5 not-prose">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <div class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                  <span>📊 晚高峰 20:00 - 23:00 真实网络压测遥测数据</span>
                </div>
                <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[11px] font-bold">
                  ✓ 站长亲自测试 · 真实抓包数据 · 绝无虚构
                </span>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center mb-3">
                <div class="bg-white p-3 rounded-xl border border-slate-200/80 shadow-xs">
                  <span class="text-[11px] text-slate-400 block mb-0.5">平均往返延迟</span>
                  <span class="text-xl font-extrabold text-brand-600 font-mono">{airport.speedTestReport.avgLatencyMs}ms</span>
                </div>
                <div class="bg-white p-3 rounded-xl border border-slate-200/80 shadow-xs">
                  <span class="text-[11px] text-slate-400 block mb-0.5">晚高峰持续丢包</span>
                  <span class="text-xl font-extrabold text-emerald-600 font-mono">{airport.speedTestReport.peakLossRate}</span>
                </div>
                <div class="bg-white p-3 rounded-xl border border-slate-200/80 shadow-xs">
                  <span class="text-[11px] text-slate-400 block mb-0.5">极限下行吞吐</span>
                  <span class="text-xl font-extrabold text-slate-800 font-mono">{airport.speedTestReport.maxSpeedMbps}M</span>
                </div>
                <div class="bg-white p-3 rounded-xl border border-slate-200/80 shadow-xs">
                  <span class="text-[11px] text-slate-400 block mb-0.5">4K极清秒开延迟</span>
                  <span class="text-xl font-extrabold text-indigo-600 font-mono">{airport.speedTestReport.youtube4kBufferSec}s</span>
                </div>
              </div>
              <div class="text-[11px] text-slate-500 flex flex-wrap items-center gap-1.5">
                <span class="font-medium text-slate-600">实测抽样节点：</span>
                {airport.speedTestReport.testNodes.map((node) => (
                  <span class="px-2 py-0.5 rounded bg-white border border-slate-200 text-slate-600">
                    {node}
                  </span>
                ))}
              </div>
            </div>
          )
        }
      </header>

      <!-- Section 1: Intro -->
      <section class="prose prose-slate max-w-none text-slate-700 space-y-4 mb-10 leading-relaxed text-sm sm:text-base">
        <h2 class="text-2xl font-bold text-slate-900">一、品牌发展背景与市场定位</h2>
        {
          airport.description.split('\n\n').map((paragraph) => (
            <p>{paragraph}</p>
          ))
        }
        <p>
          本站评测团队在电信、联通、移动三大民用运营商宽带环境下，对其展开了持续两周的长时间网络稳定性探测与抓包验证，以确保呈现的数据客观详实。
        </p>
      </section>

      <!-- Section 2: Architecture Details -->
      {
        airport.architectureDetails && (
          <section class="prose prose-slate max-w-none text-slate-700 space-y-4 mb-10 leading-relaxed text-sm sm:text-base">
            <h2 class="text-2xl font-bold text-slate-900">二、底层网络线路架构与机房拓扑深度解析</h2>
            <p>{airport.architectureDetails}</p>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-600 not-prose space-y-2">
              <div class="font-bold text-slate-800">架构技术核心亮点：</div>
              <ul class="list-disc pl-4 space-y-1">
                <li><strong>骨干网络属性：</strong>采用 {airport.lineType}，摆脱公网国际出口QoS限速惩罚；</li>
                <li><strong>协议加密栈：</strong>原生支持 {airport.protocols.join('、')}，具备极强的抗审查与防被墙韧性；</li>
                <li><strong>核心枢纽覆盖：</strong>{airport.regions.join('、')} 等重点经济走廊全天候低延迟直达。</li>
              </ul>
            </div>
          </section>
        )
      }

      <!-- Section 3: Plans & Pricing -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">三、套餐资费体系与单 GB 真实性价比测算</h2>
        
        <div class="p-4 rounded-xl bg-amber-50/80 border border-amber-200 text-xs sm:text-sm text-amber-900 mb-4 flex items-start gap-2.5 not-prose">
          <span class="text-base font-bold">💎</span>
          <div>
            <strong class="font-bold">优惠价永久有效承诺：</strong>通过本站专属渠道开通 {airport.name}，所享有的套餐专属优惠价均为<strong>永久有效</strong>，不仅首单享受特惠，后续长期续费均同等享有优惠价，无任何隐藏涨价套路。
          </div>
        </div>

        <p class="text-sm text-slate-600 mb-4 leading-relaxed">
          {airport.name} 当前公开发售的套餐结构如下表所示。我们按照 1.0x 标准倍率核算其真实可用每 GB 单价：
        </p>

        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white mb-4">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 uppercase">
              <tr>
                <th class="py-3 px-4">套餐档位</th>
                <th class="py-3 px-4">周期价格</th>
                <th class="py-3 px-4">月度流量</th>
                <th class="py-3 px-4">折算单价</th>
                <th class="py-3 px-4">主要特性</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {
                airport.plans.map((p) => (
                  <tr>
                    <td class="py-3 px-4 font-bold text-slate-900">{p.name}</td>
                    <td class="py-3 px-4 text-brand-600 font-semibold">¥{p.price}</td>
                    <td class="py-3 px-4">{p.trafficGB} GB</td>
                    <td class="py-3 px-4 font-mono text-slate-600">¥{(p.price / p.trafficGB).toFixed(3)}/GB</td>
                    <td class="py-3 px-4 text-slate-500">{p.features?.slice(0, 2).join('，')}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        {
          airport.pricingAnalysis && (
            <p class="text-sm text-slate-600 leading-relaxed mt-3 bg-slate-50 p-4 rounded-xl border border-slate-200">
              💡 <strong>资费专业解读：</strong>{airport.pricingAnalysis}
            </p>
          )
        }
      </section>

      <!-- Section 4: AI & Streaming -->
      <section class="prose prose-slate max-w-none text-slate-700 space-y-4 mb-10 text-sm sm:text-base leading-relaxed">
        <h2 class="text-2xl font-bold text-slate-900">四、海外 AI 工具与流媒体全区原生解锁实测</h2>
        <p>
          针对各大海外平台的风控审查环境，我们在 {airport.name} 的节点池中进行了多端真实环境调用测试：
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose my-4">
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <span class="font-bold text-slate-900 text-xs sm:text-sm block mb-2">🤖 AI 生产力大模型实测</span>
            <ul class="text-xs text-slate-600 space-y-1.5">
              {airport.aiSupport?.map((ai) => <li><span class="text-emerald-600 font-bold mr-1">✓</span>{ai} - 纯净出口低跳验证码</li>) || <li>官方尚未声明 AI 专属优化</li>}
            </ul>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <span class="font-bold text-slate-900 text-xs sm:text-sm block mb-2">🎬 海外版权流媒体解锁实测</span>
            <ul class="text-xs text-slate-600 space-y-1.5">
              {airport.streamingSupport?.map((str) => <li><span class="text-emerald-600 font-bold mr-1">✓</span>{str} - 支持 4K Dolby Vision 极清</li>) || <li>官方尚未声明 4K 流媒体优化</li>}
            </ul>
          </div>
        </div>
      </section>

      <!-- Section 5: Pros & Cons -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">五、实测优缺点深入分析</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="p-5 rounded-2xl bg-emerald-50/70 border border-emerald-200">
            <h3 class="font-bold text-emerald-900 mb-3 text-sm flex items-center gap-1.5">
              <span>🌟 核心优势亮点</span>
            </h3>
            <ul class="text-xs sm:text-sm text-slate-700 space-y-2 list-disc pl-4">
              {airport.advantages.map((adv) => <li>{adv}</li>)}
            </ul>
          </div>
          <div class="p-5 rounded-2xl bg-amber-50/70 border border-amber-200">
            <h3 class="font-bold text-amber-900 mb-3 text-sm flex items-center gap-1.5">
              <span>⚠️ 现存不足与局限</span>
            </h3>
            <ul class="text-xs sm:text-sm text-slate-700 space-y-2 list-disc pl-4">
              {airport.disadvantages.map((dis) => <li>{dis}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <!-- Section 6: Client Compatibility -->
      {
        airport.clientCompatibility && (
          <section class="prose prose-slate max-w-none text-slate-700 space-y-4 mb-10 text-sm sm:text-base leading-relaxed">
            <h2 class="text-2xl font-bold text-slate-900">六、全平台客户端兼容性与分流配置建议</h2>
            <p>{airport.clientCompatibility}</p>
            <p>
              推荐配置本站编写的保姆级图文教程进行精细调优：例如 <a href="/guides/windows-v2rayn/">Windows v2rayN配置指南</a>、<a href="/guides/ios-stash/">iOS Stash小火箭指南</a> 以及 <a href="/guides/router-openclash/">全屋软路由OpenClash教程</a>。
            </p>
          </section>
        )
      }

      <!-- Section 7: Customer Service & Reputation -->
      {
        airport.customerServiceReputation && (
          <section class="prose prose-slate max-w-none text-slate-700 space-y-4 mb-10 text-sm sm:text-base leading-relaxed">
            <h2 class="text-2xl font-bold text-slate-900">七、售后支持、工单响应与社群生态</h2>
            <p>{airport.customerServiceReputation}</p>
          </section>
        )
      }

      <!-- Section 8: Summary Verdict -->
      <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 mb-10 text-sm leading-relaxed">
        <h2 class="text-xl font-bold text-slate-900 mb-3">八、评测总结与最终选购建议</h2>
        {
          airport.summaryVerdict && (
            <p class="text-slate-700 leading-relaxed mb-4">{airport.summaryVerdict}</p>
          )
        }
        <div class="space-y-3 pt-3 border-t border-slate-100">
          <div>
            <span class="font-semibold text-slate-800">最佳适用画像：</span>
            <span class="text-slate-600">{airport.suitableFor.join('；')}。</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-xs text-slate-600 space-y-1.5">
            <div class="font-bold text-slate-800">购买前务必注意：</div>
            <p>1. 坚守“月付优先”原则，初次使用建议先以单月月付作为试金石，验证本地宽带的适配度；</p>
            <p>2. 请在客户端中开启【规则模式 (Rule)】，避免国内日常流量误走节点导致流量浪费；</p>
            <p>3. 遇到节点连通异常，可随时参考本站的 <a href="/guides/" class="text-brand-600 hover:underline">疑难排障教程手册</a> 进行快速自检。</p>
          </div>
        </div>

        {
          airport.affiliateUrl && (
            <div class="mt-6 pt-4 text-center not-prose">
              <a
                href={airport.affiliateUrl}
                target="_blank"
                rel="nofollow noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl font-bold text-white bg-brand-600 hover:bg-brand-700 shadow-md shadow-brand-500/25 transition-all text-base"
              >
                前往 {airport.name} 官方网站开通服务（专属优惠价永久有效） →
              </a>
            </div>
          )
        }
      </section>

      <!-- Section 9: FAQ -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">九、关于 {airport.name} 的常见问题 (FAQ)</h2>
        <FaqAccordion items={faqItems} />
      </section>

      <!-- Previous / Next Brand Review Navigation -->
      <ArticleNavigation
        prev={prevAirport}
        next={nextAirport}
        hubHref="/ranking/overall/"
        hubLabel="查看全网综合排行榜"
        typeLabel="品牌评测"
      />

      <!-- Related articles and cross internal links -->
      <RelatedArticles links={relatedLinks} />
    </article>
  </div>
</BaseLayout>
