---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guides');
allGuides.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pageTitle = '科学上网客户端使用教程中心 | Windows/Mac/iOS/Android指南 - 梯子评测网';
const pageDescription = '梯子评测网新手使用教程中心。提供 Windows (Clash Verge Rev)、Android (Clash Meta/Surfboard)、iOS (Shadowrocket小火箭)、Mac 及软路由透明网关的零基础图文配置指南。';

const breadcrumbs = [
  { label: '使用教程', href: '/guides/windows/' },
];

const platforms = [
  {
    name: 'Windows 电脑',
    slug: 'windows',
    tag: 'Clash Verge Rev / v2rayN',
    desc: '微软 Windows 10/11 系统配置指南，支持一键导入订阅与系统代理智能分流。',
    href: '/guides/windows/',
    iconColor: 'bg-blue-500',
  },
  {
    name: 'Android 安卓手机',
    slug: 'android',
    tag: 'Clash Meta / Surfboard',
    desc: '华为、小米、OPPO、vivo 及三星安卓手机配置教程，含后台防杀保活设置。',
    href: '/guides/android/',
    iconColor: 'bg-emerald-500',
  },
  {
    name: 'iOS 苹果手机',
    slug: 'ios',
    tag: 'Shadowrocket 小火箭',
    desc: 'iPhone 与 iPad 获取美区 Apple ID、安装小火箭与分流规则导入详细步骤。',
    href: '/guides/ios/',
    iconColor: 'bg-purple-500',
  },
  {
    name: 'macOS 苹果电脑',
    slug: 'macos',
    tag: 'Clash Verge Rev / Surge',
    desc: '针对 Apple Silicon M系列与 Intel 芯片 Mac 的安装、系统代理与终端环境配置。',
    href: '/guides/macos/',
    iconColor: 'bg-slate-700',
  },
  {
    name: 'Apple TV 与软路由',
    slug: 'appletv-router',
    tag: '旁路由 / tvOS 原生小火箭',
    desc: '客厅大屏 4K 流媒体秒开、家庭全屋智能设备无感全局翻墙网关实战方案。',
    href: '/guides/appletv-router/',
    iconColor: 'bg-amber-500',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="max-w-3xl mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200 mb-3">
        <span>📖 全平台图文实操</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        科学上网客户端使用教程中心
      </h1>
      <p class="text-base text-slate-600 leading-relaxed">
        告别晦涩的技术术语。无论您使用的是 Windows 电脑、安卓手机、iPhone 还是 Mac，我们都准备了图文并茂的零基础入门指南，助您 3 分钟完成节点订阅与一键连接。
      </p>
    </header>

    <!-- Platform Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-14">
      {
        platforms.map((p) => (
          <a
            href={p.href}
            class="p-6 rounded-2xl bg-white border border-slate-200 hover:border-brand-300 hover:shadow-md transition-all group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700">
                  {p.tag}
                </span>
                <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
              </div>
              <h2 class="text-xl font-bold text-slate-900 group-hover:text-brand-600 transition-colors mb-2">
                {p.name}
              </h2>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{p.desc}</p>
            </div>
            <div class="pt-4 mt-6 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-brand-600 group-hover:translate-x-1 transition-transform">
              <span>阅读完整图文教程</span>
              <span>→</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
