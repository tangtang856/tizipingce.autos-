---
import BaseLayout from '@/layouts/BaseLayout.astro';

const pageTitle = '404 - 页面未找到 | 梯子评测网';
const pageDescription = '抱歉，您访问的页面不存在或已被移除。您可以返回首页、查看最新机场排行榜或使用横向对比工具。';
---

<BaseLayout title={pageTitle} description={pageDescription} robots="noindex, nofollow">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <div class="max-w-md mx-auto">
      <div class="text-7xl font-extrabold text-brand-600 mb-4 tracking-tight">404</div>
      <h1 class="text-2xl font-bold text-slate-900 mb-2">抱歉，您访问的页面不存在</h1>
      <p class="text-sm text-slate-500 mb-8 leading-relaxed">
        您可能点击了已失效的链接，或该页面已变更了路径。请尝试从以下核心入口寻找所需资讯：
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/"
          class="px-6 py-2.5 rounded-xl bg-brand-600 text-white font-medium text-sm hover:bg-brand-700 transition-colors shadow-sm"
        >
          返回网站首页
        </a>
        <a
          href="/ranking/overall/"
          class="px-6 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-700 font-medium text-sm hover:bg-slate-50 transition-colors"
        >
          查看综合排行榜
        </a>
        <a
          href="/compare/"
          class="px-6 py-2.5 rounded-xl bg-slate-100 text-slate-700 font-medium text-sm hover:bg-slate-200 transition-colors"
        >
          在线参数对比
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
