---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import AirportCard from '@/components/AirportCard.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import RelatedArticles from '@/components/RelatedArticles.astro';
import { getAllAirports } from '@/data/airports';

const airports = getAllAirports().filter((a) => a.lineType.includes('IPLC') || a.lineType.includes('IEPL') || a.lineType.includes('BGP'));

const pageTitle = '抗封锁高稳定性机场推荐 | 晚高峰不卡顿测评 - 梯子评测网';
const pageDescription = '2026年高稳定性机场推荐。专注晚高峰（20:00-23:00）不卡顿、敏感管制期不失联的机场节点，精选自建 BGP 入口与物理 IPLC 专线服务商。';

const breadcrumbs = [
  { label: '机场推荐', href: '/recommend/budget/' },
  { label: '高稳定性推荐', href: '/recommend/stable/' },
];

const faqItems = [
  {
    question: '为什么敏感时期有些机场完全连不上，有些却安然无恙？',
    answer: '使用公网直连或普通中转的机场，其出境服务器 IP 暴露在公网中，容易被防火墙批量阻断封锁端口；而采用物理 IPLC 专线的机场数据经由私有物理光纤内网传输，完全不与公网审查点交互，因此丝毫不受封锁风暴影响。',
  },
];

const relatedLinks = [
  { title: '2026稳定性排行榜', href: '/ranking/stable/', category: '排行榜' },
  { title: '全平台客户端评测与选型指南', href: '/blog/clients-comparison/', category: '博客' },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="max-w-3xl mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200 mb-3">
        <span>🛡️ 晚高峰与敏感期保障</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        高稳定性抗封锁机场推荐：晚高峰丝滑不卡顿
      </h1>
      <p class="text-base text-slate-600 leading-relaxed">
        针对日常需要长时间远程 SSH、高频视频通话以及在晚间黄金时段进行大带宽下载的用户，稳定性是第一核心诉求。
      </p>
    </header>

    <section class="mb-14">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {airports.map((airport) => (
          <AirportCard airport={airport} highlightFeature="高可用低抖动" />
        ))}
      </div>
    </section>

    <FaqAccordion items={faqItems} title="网络稳定性核心知识FAQ" />
    <RelatedArticles links={relatedLinks} />
  </div>
</BaseLayout>
