        </div>
      </section>

      <!-- Previous / Next Article Navigation -->
      <ArticleNavigation
        prev={prevPost}
        next={nextPost}
        hubHref="/blog/"
        hubLabel="返回博客中心"
        typeLabel="文章"
      />

      <!-- Related articles and cross internal links -->
      <RelatedArticles links={relatedLinks} />
    </article>
  </div>
</BaseLayout>
