---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pageTitle = '出海资讯与博客科普专栏 | 梯子评测网';
const pageDescription = '梯子评测网博客专栏。提供 VPN 与机场的区别科普、机场选购避坑指南、测速真相揭秘、客户端选型对比以及订阅链接安全防护等深度干货内容。';

const breadcrumbs = [
  { label: '博客专栏', href: '/blog/' },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="max-w-3xl mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200 mb-3">
        <span>✍️ 原创深度解析</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        出海资讯与代理技术博客专栏
      </h1>
      <p class="text-base text-slate-600 leading-relaxed">
        摆脱晦涩难懂的技术门槛。由一线网络工程师与资深出海用户执笔，带来硬核客观的代理协议科普、安全防护建议与选型实操。
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-14">
      {
        posts.map((post) => {
          const slug = post.id.replace(/\.(md|mdx)$/, '');
          return (
            <article class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col justify-between hover:shadow-md transition-shadow group">
              <div>
                <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                  <span class="px-2.5 py-0.5 rounded-full bg-brand-50 text-brand-700 font-semibold">
                    {post.data.category}
                  </span>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toISOString().slice(0, 10)}
                  </time>
                </div>
                <h2 class="text-xl font-bold text-slate-900 group-hover:text-brand-600 transition-colors mb-3 leading-snug">
                  <a href={`/blog/${slug}/`}>{post.data.title}</a>
                </h2>
                <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed mb-4">
                  {post.data.description}
                </p>
              </div>
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs text-slate-400">{post.data.author}</span>
                <a
                  href={`/blog/${slug}/`}
                  class="text-xs font-semibold text-brand-600 group-hover:underline flex items-center gap-1"
                >
                  阅读全文 →
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</BaseLayout>
