---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import RelatedArticles from '@/components/RelatedArticles.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const terms = await getCollection('glossary');
  return terms.map((term) => ({
    params: { slug: term.id.replace(/\.(md|mdx)$/, '') },
    props: { term },
  }));
}

const { term } = Astro.props;
const { Content } = await render(term);

const pageTitle = `${term.data.title} | 梯子评测网术语百科`;
const pageDescription = term.data.description;

const breadcrumbs = [
  { label: '术语百科', href: '/glossary/node-types/' },
  { label: term.data.term, href: `/glossary/${term.id.replace(/\.(md|mdx)$/, '')}/` },
];

const relatedLinks = [
  { title: '2026综合实力排行榜', href: '/ranking/overall/', category: '排行榜' },
  { title: '多品牌同屏横向对比工具', href: '/compare/', category: '对比工具' },
  { title: '新手友好型机场推荐', href: '/recommend/beginner/', category: '专题推荐' },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: term.data.term,
  description: term.data.description,
  inDefinedTermSet: 'https://tizipingce.autos/glossary/',
};
---

<BaseLayout title={pageTitle} description={pageDescription} ogType="article" schema={articleSchema}>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <article class="max-w-prose mx-auto">
      <header class="mb-10 pb-6 border-b border-slate-200">
        <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
          <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 font-semibold">
            {term.data.category}
          </span>
          <span>更新于：{term.data.updatedDate?.toISOString().slice(0, 10) || term.data.pubDate.toISOString().slice(0, 10)}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
          {term.data.title}
        </h1>
        <p class="text-base text-slate-600 leading-relaxed">
          {term.data.description}
        </p>
      </header>

      <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed text-sm sm:text-base space-y-5">
        <Content />
      </div>

      <RelatedArticles links={relatedLinks} />
    </article>
  </div>
</BaseLayout>
