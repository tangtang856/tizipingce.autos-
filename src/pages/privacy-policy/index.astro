---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

const pageTitle = '隐私政策 | 梯子评测网';
const pageDescription = '梯子评测网（tizipingce.autos）隐私政策。我们尊重并保护所有访问者的个人隐私，不收集敏感个人信息，说明 Cookie 与外部链接使用规范。';

const breadcrumbs = [
  { label: '隐私政策', href: '/privacy-policy/' },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <article class="max-w-prose mx-auto">
      <header class="mb-10 pb-6 border-b border-slate-200">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
          隐私权保护政策
        </h1>
        <p class="text-xs text-slate-400">最后生效与修订日期：2026年3月20日</p>
      </header>

      <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed text-sm sm:text-base space-y-6">
        <p>
          梯子评测网（以下简称“本站”，域名为 <strong>tizipingce.autos</strong>）极其重视用户的个人隐私与数据安全。本隐私政策旨在向您说明本站在您浏览与使用本站服务时，如何处理与保护相关信息。
        </p>

        <h2 class="text-xl font-bold text-slate-900">一、信息收集原则</h2>
        <p>
          本站作为纯静态技术资讯网站，<strong>不强制要求用户注册账号，不收集您的姓名、电话号码、身份证件或支付账号等敏感个人身份信息</strong>。
        </p>

        <h2 class="text-xl font-bold text-slate-900">二、网络日志与匿名统计</h2>
        <p>
          当您访问本站时，托管服务商（如 Cloudflare）可能会自动记录基础的匿名网络请求日志（包括访问 IP 地址、浏览器类型、操作系统、访问时间及请求的页面 URL）。这些数据仅用于保障网站基础运行安全、抵御恶意 DDoS 攻击与统计全站总体访问流量，绝不会用于逆向追踪特定个人。
        </p>

        <h2 class="text-xl font-bold text-slate-900">三、Cookie 与本地存储</h2>
        <p>
          本站仅使用必要的本地存储（如记录您在对比工具中选择的机场偏好）以提升交互便利度。本站不使用侵入式的第三方跨站追踪 Cookie。
        </p>

        <h2 class="text-xl font-bold text-slate-900">四、第三方外部链接声明</h2>
        <p>
          本站包含跳转至第三方机场官网或开源软件 GitHub 仓库的链接。一旦您离开本站访问第三方网站，其隐私条款与数据安全由对应第三方负责，建议您在访问时查阅其专属隐私声明。
        </p>
      </div>
    </article>
  </div>
</BaseLayout>
