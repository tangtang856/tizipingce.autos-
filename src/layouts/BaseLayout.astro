---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonical?: string;
  robots?: string;
  ogType?: 'website' | 'article';
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  description,
  keywords,
  canonical,
  robots = 'index, follow',
  ogType = 'website',
  schema,
} = Astro.props;

const siteUrl = 'https://tizipingce.autos';
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const canonicalUrl = canonical || `${siteUrl}${cleanPath}`;

// Base Schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '梯子评测网',
  url: siteUrl,
  description: '专业的中文机场推荐、梯子节点评测与科学上网配置指南媒体。',
  inLanguage: 'zh-CN',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/ranking/overall/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '梯子评测网',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  sameAs: ['https://github.com/tangtang856/tizipingce.autos'],
};
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={robots} />
    <meta name="msvalidate.01" content="0D4957E8492040689B7C8449C258D4A1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="梯子评测网" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {
      schema && (
        Array.isArray(schema) ? (
          schema.map((s) => (
            <script type="application/ld+json" set:html={JSON.stringify(s)} />
          ))
        ) : (
          <script type="application/ld+json" set:html={JSON.stringify(schema)} />
        )
      )
    }

    <!-- Dreamy Pastel & Iridescent Grid Aesthetic Styles -->
    <style is:global>
      /* ==========================================================================
         柔和梦幻治愈系背景系统 (Dreamy Healing Pastel Blue & Yellow Background)
         ========================================================================== */

      /* 1. Base Multi-stop Pastel Gradient (淡蓝与淡黄色自然流动) */
      .dreamy-base-mesh {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        background: 
          radial-gradient(circle at 10% 12%, rgba(219, 234, 254, 0.85) 0%, transparent 50%),
          radial-gradient(circle at 92% 20%, rgba(254, 240, 138, 0.75) 0%, transparent 50%),
          radial-gradient(circle at 85% 85%, rgba(186, 230, 253, 0.8) 0%, transparent 55%),
          radial-gradient(circle at 12% 82%, rgba(254, 249, 195, 0.8) 0%, transparent 55%),
          linear-gradient(135deg, #f0f7ff 0%, #fffef2 32%, #e6f3fd 68%, #fefce8 100%);
      }

      /* 2. Floating Luminous Orbs (柔和光影，色彩过渡自然流畅) */
      .dreamy-orb {
        position: absolute;
        border-radius: 9999px;
        pointer-events: none;
      }

      .dreamy-orb-blue-1 {
        top: -10vw;
        left: -8vw;
        width: 60vw;
        height: 60vw;
        max-width: 900px;
        max-height: 900px;
        background: radial-gradient(circle, rgba(186, 230, 253, 0.75) 0%, rgba(224, 242, 254, 0.45) 45%, transparent 70%);
        filter: blur(65px);
      }

      .dreamy-orb-yellow-1 {
        top: 5vh;
        right: -10vw;
        width: 55vw;
        height: 55vw;
        max-width: 850px;
        max-height: 850px;
        background: radial-gradient(circle, rgba(254, 240, 138, 0.65) 0%, rgba(254, 249, 195, 0.4) 45%, transparent 70%);
        filter: blur(70px);
      }

      .dreamy-orb-blue-2 {
        bottom: -12vh;
        right: -6vw;
        width: 65vw;
        height: 65vw;
        max-width: 950px;
        max-height: 950px;
        background: radial-gradient(circle, rgba(147, 197, 253, 0.6) 0%, rgba(191, 219, 254, 0.35) 50%, transparent 70%);
        filter: blur(75px);
      }

      .dreamy-orb-yellow-2 {
        bottom: 8vh;
        left: -8vw;
        width: 52vw;
        height: 52vw;
        max-width: 820px;
        max-height: 820px;
        background: radial-gradient(circle, rgba(253, 224, 71, 0.45) 0%, rgba(254, 240, 138, 0.3) 45%, transparent 70%);
        filter: blur(70px);
      }

      .dreamy-orb-rainbow {
        top: 32vh;
        left: 28vw;
        width: 48vw;
        height: 48vw;
        max-width: 720px;
        max-height: 720px;
        background: radial-gradient(circle, rgba(244, 114, 182, 0.12) 0%, rgba(167, 243, 208, 0.18) 40%, rgba(199, 210, 254, 0.22) 65%, transparent 80%);
        filter: blur(85px);
        mix-blend-mode: color-dodge;
      }

      /* 3. Luminous Highlight Bloom (高光区域明亮而不刺眼) */
      .dreamy-highlight-bloom {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100vw;
        height: 550px;
        background: radial-gradient(
          ellipse 65% 55% at 50% 0%,
          rgba(255, 255, 255, 0.95) 0%,
          rgba(255, 254, 235, 0.7) 25%,
          rgba(224, 242, 254, 0.35) 55%,
          transparent 100%
        );
        filter: blur(24px);
        pointer-events: none;
      }

      /* 4. Delicate Grid Mesh (细腻平滑的格子纹路) */
      .dreamy-grid-mesh {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        background-size: 38px 38px;
        background-image:
          linear-gradient(to right, rgba(56, 189, 248, 0.2) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(234, 179, 8, 0.16) 1px, transparent 1px);
        mask-image: radial-gradient(
          ellipse 95% 85% at 50% 25%,
          black 30%,
          rgba(0, 0, 0, 0.85) 60%,
          rgba(0, 0, 0, 0.45) 88%,
          transparent 100%
        );
        -webkit-mask-image: radial-gradient(
          ellipse 95% 85% at 50% 25%,
          black 30%,
          rgba(0, 0, 0, 0.85) 60%,
          rgba(0, 0, 0, 0.45) 88%,
          transparent 100%
        );
        pointer-events: none;
      }

      /* 5. Iridescent Luster Sheen (纹路呈现出炫彩的光泽效果) */
      .dreamy-iridescent-glow {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          125deg,
          rgba(56, 189, 248, 0.16) 0%,
          rgba(250, 204, 21, 0.16) 25%,
          rgba(244, 114, 182, 0.12) 48%,
          rgba(52, 211, 153, 0.12) 72%,
          rgba(129, 140, 248, 0.16) 100%
        );
        mix-blend-mode: overlay;
        opacity: 0.85;
        pointer-events: none;
      }

      /* ==========================================================================
         轻盈通透的半透明质感 (Translucent Frosted Glass Aesthetic)
         ========================================================================== */

      /* Semi-transparent frosted glass treatment for white surfaces */
      .bg-white {
        background-color: rgba(255, 255, 255, 0.84) !important;
        backdrop-filter: blur(14px) saturate(160%);
        -webkit-backdrop-filter: blur(14px) saturate(160%);
      }

      /* Exception for popovers, modals and dropdowns that require higher opacity */
      [data-popover],
      .dropdown-menu,
      #contact-modal-dialog {
        background-color: rgba(255, 255, 255, 0.96) !important;
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
      }

      /* Delicate frosted card edges */
      .border-slate-200 {
        border-color: rgba(226, 232, 240, 0.75) !important;
      }

      /* Frosted glass cards */
      .glass-card {
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(14px) saturate(160%);
        -webkit-backdrop-filter: blur(14px) saturate(160%);
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 4px 20px -2px rgba(147, 197, 253, 0.1), 0 2px 6px -1px rgba(0, 0, 0, 0.04);
      }

      .glass-card:hover {
        background: rgba(255, 255, 255, 0.92);
        box-shadow: 0 8px 30px -4px rgba(147, 197, 253, 0.18), 0 4px 12px -2px rgba(0, 0, 0, 0.06);
      }
    </style>
  </head>
  <body class="relative text-slate-900 font-sans antialiased min-h-screen flex flex-col selection:bg-brand-500 selection:text-white">
    <!-- Dreamy Fox Illustration & Grid Aesthetic Background Layer -->
    <div class="fixed inset-0 -z-10 pointer-events-none overflow-hidden select-none" aria-hidden="true">
      <!-- High-resolution dreamy fox wallpaper background -->
      <img
        src="/bg.jpg"
        alt=""
        class="w-full h-full object-cover object-center fixed inset-0 -z-20 pointer-events-none select-none"
      />
      <!-- Soft translucent ambient lighting to enhance contrast & legibility -->
      <div class="fixed inset-0 -z-10 bg-white/20 backdrop-blur-[0.5px]"></div>
      <!-- Subtle top light bloom & delicate iridescent grid mesh -->
      <div class="dreamy-highlight-bloom opacity-50"></div>
      <div class="dreamy-grid-mesh opacity-25"></div>
      <div class="dreamy-iridescent-glow opacity-30"></div>
    </div>

    <Header currentPath={currentPath} />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
