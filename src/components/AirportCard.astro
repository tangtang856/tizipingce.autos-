---
import type { Airport } from '../data/airports';

interface Props {
  airport: Airport;
  rankBadge?: number;
  highlightFeature?: string;
}

const { airport, rankBadge, highlightFeature } = Astro.props;
const lowestPlan = airport.plans[0];
---

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all p-6 flex flex-col justify-between relative overflow-hidden group">
  {
    rankBadge && (
      <div class:list={[
        'absolute top-0 right-0 px-3.5 py-1 text-xs font-bold rounded-bl-xl tracking-wider uppercase',
        rankBadge === 1
          ? 'bg-amber-400 text-slate-900 shadow-sm'
          : rankBadge === 2
          ? 'bg-slate-300 text-slate-800'
          : rankBadge === 3
          ? 'bg-amber-700 text-amber-50'
          : 'bg-slate-100 text-slate-600',
      ]}>
        TOP {rankBadge}
      </div>
    )
  }

  <div>
    <!-- Header info -->
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <h3 class="text-xl font-bold text-slate-900 group-hover:text-brand-600 transition-colors">
          <a href={`/airport/${airport.slug}/`}>{airport.name}</a>
        </h3>
        <p class="text-xs font-medium text-slate-500 mt-0.5">{airport.tagline}</p>
      </div>
    </div>

    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-brand-50 text-brand-700 border border-brand-200">
        {airport.lineType}
      </span>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
        ✓ 站长亲自测试 · 真实数据
      </span>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-800 border border-amber-200">
        🔥 优惠价永久有效
      </span>
      {
        highlightFeature && (
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-50 text-purple-700 border border-purple-200">
            {highlightFeature}
          </span>
        )
      }
    </div>

    <!-- Description -->
    <p class="text-sm text-slate-600 line-clamp-3 mb-5 leading-relaxed">
      {airport.description}
    </p>

    <!-- Key Metrics Grid -->
    <div class="grid grid-cols-2 gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-100 mb-5 text-xs">
      <div>
        <div class="flex items-center gap-1 mb-0.5">
          <span class="text-slate-400">起步价格</span>
          <span class="text-[10px] text-amber-700 font-bold bg-amber-100/90 px-1 rounded">永久优惠</span>
        </div>
        <span class="text-base font-bold text-slate-900">
          ¥{airport.startingPrice}
          <span class="text-xs font-normal text-slate-500">/起</span>
        </span>
      </div>
      <div>
        <span class="text-slate-400 block mb-0.5">入门流量</span>
        <span class="text-base font-bold text-slate-900">
          {lowestPlan?.trafficGB ?? '详见套餐'} GB
        </span>
      </div>
      <div>
        <span class="text-slate-400 block mb-0.5">协议支持</span>
        <span class="font-medium text-slate-700 truncate block">
          {airport.protocols.slice(0, 2).join(', ')}
        </span>
      </div>
      <div>
        <span class="text-slate-400 block mb-0.5">地区覆盖</span>
        <span class="font-medium text-slate-700 truncate block">
          {airport.regions.slice(0, 3).join('、')}等
        </span>
      </div>
    </div>

    <!-- Pros & Cons List -->
    <div class="space-y-2 mb-6 text-xs">
      <div class="space-y-1">
        <span class="font-semibold text-emerald-800 flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          核心优势
        </span>
        <p class="text-slate-600 pl-4">{airport.advantages[0]}</p>
      </div>
      <div class="space-y-1">
        <span class="font-semibold text-amber-800 flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          注意事项
        </span>
        <p class="text-slate-600 pl-4">{airport.disadvantages[0]}</p>
      </div>
    </div>
  </div>

  <!-- Bottom CTA Actions -->
  <div class="pt-4 border-t border-slate-100 flex items-center gap-2.5">
    <a
      href={`/airport/${airport.slug}/`}
      class="flex-1 text-center py-2 px-3 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors"
    >
      参数与档案
    </a>
    <a
      href={`/review/${airport.slug}/`}
      class="flex-1 text-center py-2 px-3 text-xs font-semibold text-brand-700 bg-brand-50 hover:bg-brand-100 rounded-lg transition-colors border border-brand-200"
    >
      深度评测
    </a>
    {
      airport.affiliateUrl && (
        <a
          href={airport.affiliateUrl}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="flex-1 text-center py-2 px-3 text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-lg shadow-sm transition-all"
        >
          直达官网
        </a>
      )
    }
  </div>
</div>
