---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  title?: string;
  description?: string;
}

const {
  items,
  title = '常见问题解答 (FAQ)',
  description = '围绕机场挑选、节点稳定性、客户端配置与使用安全的常见疑问与客观解答。',
} = Astro.props;

// Build Schema FAQPage
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section class="my-12">
  <div class="mb-6">
    <h2 class="text-2xl font-bold text-slate-900">{title}</h2>
    {description && <p class="text-sm text-slate-500 mt-1">{description}</p>}
  </div>

  <div class="space-y-3">
    {
      items.map((item, index) => (
        <details class="group bg-white rounded-xl border border-slate-200 p-4 transition-all duration-200 hover:border-slate-300 [&_svg]:open:-rotate-180">
          <summary class="flex items-center justify-between cursor-pointer font-semibold text-slate-900 group-hover:text-brand-600 transition-colors list-none select-none">
            <span class="text-base flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-md bg-brand-50 text-brand-600 text-xs flex items-center justify-center font-bold shrink-0">
                Q{index + 1}
              </span>
              <span>{item.question}</span>
            </span>
            <svg
              class="w-5 h-5 text-slate-400 shrink-0 transition-transform duration-200"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-3.5 pt-3.5 border-t border-slate-100 text-sm text-slate-600 leading-relaxed">
            <p>{item.answer}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
