---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { label: '首页', href: '/' },
  { label: '机场推荐', href: '/recommend/budget/' },
  { label: '综合排行', href: '/ranking/overall/' },
  { label: '机场对比', href: '/compare/' },
  { label: '独立评测', href: '/review/' },
  { label: '使用教程', href: '/guides/windows/' },
  { label: '博客文章', href: '/blog/' },
  { label: '术语百科', href: '/glossary/node-types/' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-xl border-b border-white/70 shadow-[0_4px_24px_rgba(147,197,253,0.06)] transition-all">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group" aria-label="梯子评测网首页">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-700 via-brand-600 to-blue-400 flex items-center justify-center text-white shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-lg font-bold tracking-tight text-slate-900 group-hover:text-brand-600 transition-colors">
          梯子评测网
        </span>
        <span class="text-[11px] font-medium text-slate-500 leading-none tracking-wider">
          tizipingce.autos
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'px-3 py-1.5 rounded-lg text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'bg-brand-50 text-brand-700 font-semibold'
                : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Right Action / Mobile Button -->
    <div class="flex items-center gap-2">
      <!-- Contact Us Button with Popover -->
      <div class="relative" id="contact-popover-wrapper">
        <button
          id="contact-toggle-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 hover:text-brand-600 rounded-lg transition-all border border-slate-200"
          aria-expanded="false"
          aria-haspopup="dialog"
        >
          <svg class="w-3.5 h-3.5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <span>联络我们</span>
          <svg class="w-3 h-3 text-slate-400 transition-transform duration-200" id="contact-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Popover Panel -->
        <div
          id="contact-popover-panel"
          class="hidden absolute right-0 mt-2.5 w-80 sm:w-96 rounded-2xl bg-white border border-slate-200 shadow-2xl z-50 p-5 text-left transition-all"
        >
          <!-- Header -->
          <div class="flex items-center justify-between pb-3.5 border-b border-slate-100 mb-4">
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center text-sm font-bold shadow-xs">📬</span>
              <div>
                <h4 class="text-sm font-bold text-slate-900 leading-tight">联系站长 · 官方联络通道</h4>
                <p class="text-[11px] text-slate-500">商务合作 · 节点勘误 · 技术交流</p>
              </div>
            </div>
            <button
              id="contact-close-btn"
              type="button"
              class="text-slate-400 hover:text-slate-600 p-1 rounded-md hover:bg-slate-100 text-sm leading-none"
              aria-label="关闭"
            >
              ✕
            </button>
          </div>

          <!-- Channels List -->
          <div class="space-y-3 mb-4">
            <!-- Telegram Item -->
            <div class="p-3.5 rounded-xl bg-gradient-to-r from-blue-50/70 to-sky-50/70 border border-blue-100 hover:border-blue-200 transition-all">
              <div class="flex items-center justify-between mb-1.5">
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-[#229ED9]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
                  </svg>
                  <span class="text-xs font-bold text-slate-900">Telegram 官方在线沟通</span>
                </div>
                <span class="text-[10px] text-emerald-700 font-semibold bg-emerald-100/80 px-1.5 py-0.5 rounded">快速响应</span>
              </div>
              <div class="text-xs font-mono font-bold text-slate-800 mb-2.5">@xintangtang</div>
              <div class="flex items-center gap-2">
                <a
                  href="https://t.me/xintangtang"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 text-center py-1.5 px-2.5 rounded-lg bg-[#229ED9] hover:bg-[#1e8dbf] text-white text-xs font-semibold shadow-xs transition-colors flex items-center justify-center gap-1"
                >
                  <span>立即在 TG 发起对话</span>
                  <span>→</span>
                </a>
                <button
                  type="button"
                  class="copy-btn py-1.5 px-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-medium transition-colors"
                  data-copy="@xintangtang"
                >
                  复制 ID
                </button>
              </div>
            </div>

            <!-- Gmail Item -->
            <div class="p-3.5 rounded-xl bg-gradient-to-r from-rose-50/70 to-red-50/70 border border-red-100 hover:border-red-200 transition-all">
              <div class="flex items-center justify-between mb-1.5">
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-[#EA4335]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                  </svg>
                  <span class="text-xs font-bold text-slate-900">Gmail 官方商务与工单</span>
                </div>
                <span class="text-[10px] text-slate-500 bg-white px-1.5 py-0.5 rounded border border-slate-200/60">官方邮箱</span>
              </div>
              <div class="text-xs font-mono font-bold text-slate-800 mb-2.5 truncate">xintangtang888@gmail.com</div>
              <div class="flex items-center gap-2">
                <a
                  href="mailto:xintangtang888@gmail.com"
                  class="flex-1 text-center py-1.5 px-2.5 rounded-lg bg-[#EA4335] hover:bg-[#d9382b] text-white text-xs font-semibold shadow-xs transition-colors flex items-center justify-center gap-1"
                >
                  <span>发送邮件</span>
                  <span>✉️</span>
                </a>
                <button
                  type="button"
                  class="copy-btn py-1.5 px-2.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-medium transition-colors"
                  data-copy="xintangtang888@gmail.com"
                >
                  复制邮箱
                </button>
              </div>
            </div>
          </div>

          <!-- Bottom Notice -->
          <div class="pt-3 border-t border-slate-100 text-[11px] text-slate-500 space-y-1.5 leading-relaxed">
            <div class="flex items-start gap-1 text-amber-800 bg-amber-50/60 p-2 rounded-lg border border-amber-100">
              <span class="font-bold">🛡️</span>
              <span><strong>官方防伪认证：</strong>站长仅有上述唯一的 Gmail 与 TG，绝无任何代充或私下交易。</span>
            </div>
            <div class="text-slate-400 flex items-center justify-between pt-1">
              <span>真实一手测试 · 优惠价永久有效</span>
              <a href="/contact/" class="text-brand-600 hover:underline font-medium">完整联系页面 →</a>
            </div>
          </div>
        </div>
      </div>

      <!-- 横向对比按钮 -->
      <a
        href="/compare/"
        class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-lg shadow-sm hover:shadow transition-all"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <span>横向对比</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500"
        aria-label="切换导航菜单"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Collapsible Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-1.5 shadow-lg">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'block px-3 py-2.5 rounded-lg text-sm font-medium transition-colors',
            isActive(item.href)
              ? 'bg-brand-50 text-brand-700 font-semibold'
              : 'text-slate-700 hover:bg-slate-100',
          ]}
        >
          {item.label}
        </a>
      ))
    }
    <!-- Mobile Contact Quick Box -->
    <div class="pt-2">
      <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
        <div class="text-xs font-bold text-slate-800 mb-2 flex items-center justify-between">
          <span class="flex items-center gap-1.5">
            <span>📬</span>
            <span>站长官方联络渠道</span>
          </span>
          <span class="text-[10px] text-emerald-700 bg-emerald-100/80 px-1.5 py-0.5 rounded font-semibold">快速响应</span>
        </div>
        <div class="grid grid-cols-2 gap-2 text-xs mb-2">
          <a
            href="https://t.me/xintangtang"
            target="_blank"
            rel="noopener noreferrer"
            class="py-2 px-2.5 rounded-lg bg-[#229ED9] text-white font-semibold text-center flex items-center justify-center gap-1 shadow-xs"
          >
            <span>TG: @xintangtang</span>
          </a>
          <a
            href="mailto:xintangtang888@gmail.com"
            class="py-2 px-2.5 rounded-lg bg-[#EA4335] text-white font-semibold text-center flex items-center justify-center gap-1 shadow-xs"
          >
            <span>发邮件到 Gmail</span>
          </a>
        </div>
        <p class="text-[10px] text-slate-500 m-0">官方唯一账号，防范冒充 · 真实一手测试</p>
      </div>
    </div>

    <div class="pt-2 border-t border-slate-100">
      <a
        href="/compare/"
        class="block w-full text-center px-4 py-2.5 text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-lg shadow-sm"
      >
        进入机场参数横向对比工具
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile Hamburger Menu
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }

  // Desktop Contact Popover
  const contactBtn = document.getElementById('contact-toggle-btn');
  const contactPanel = document.getElementById('contact-popover-panel');
  const contactClose = document.getElementById('contact-close-btn');
  const contactChevron = document.getElementById('contact-chevron');

  function openContact() {
    if (!contactPanel) return;
    contactPanel.classList.remove('hidden');
    contactBtn?.setAttribute('aria-expanded', 'true');
    contactChevron?.classList.add('rotate-180');
  }

  function closeContact() {
    if (!contactPanel) return;
    contactPanel.classList.add('hidden');
    contactBtn?.setAttribute('aria-expanded', 'false');
    contactChevron?.classList.remove('rotate-180');
  }

  if (contactBtn && contactPanel) {
    contactBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = contactPanel.classList.contains('hidden');
      if (isHidden) {
        openContact();
      } else {
        closeContact();
      }
    });

    contactClose?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeContact();
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!contactPanel.contains(target) && !contactBtn.contains(target)) {
        closeContact();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeContact();
      }
    });
  }

  // Copy Buttons Functionality
  const copyButtons = document.querySelectorAll('.copy-btn');
  copyButtons.forEach((button) => {
    button.addEventListener('click', async (e) => {
      e.stopPropagation();
      const textToCopy = (button as HTMLElement).dataset.copy;
      if (!textToCopy) return;

      try {
        await navigator.clipboard.writeText(textToCopy);
        const originalText = button.textContent;
        button.textContent = '已复制!';
        button.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');
        setTimeout(() => {
          button.textContent = originalText;
          button.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');
        }, 2000);
      } catch (err) {
        console.warn('Copy failed:', err);
      }
    });
  });
</script>
