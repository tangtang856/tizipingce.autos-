---
interface RelatedLink {
  title: string;
  href: string;
  category: string;
  description?: string;
}

interface Props {
  title?: string;
  links: RelatedLink[];
}

const { title = '推荐阅读与相关专题', links } = Astro.props;
---

<div class="my-10 p-6 rounded-2xl bg-gradient-to-br from-slate-50 to-brand-50/30 border border-slate-200">
  <h3 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
    <svg class="w-5 h-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
    </svg>
    {title}
  </h3>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {
      links.map((link) => (
        <a
          href={link.href}
          class="p-4 rounded-xl bg-white border border-slate-200/80 hover:border-brand-300 hover:shadow-sm transition-all group flex flex-col justify-between"
        >
          <div>
            <span class="inline-block text-[11px] font-medium text-brand-600 bg-brand-50 px-2 py-0.5 rounded mb-2">
              {link.category}
            </span>
            <h4 class="text-sm font-semibold text-slate-800 group-hover:text-brand-600 transition-colors line-clamp-2">
              {link.title}
            </h4>
          </div>
          {link.description && (
            <p class="text-xs text-slate-500 mt-2 line-clamp-2">{link.description}</p>
          )}
        </a>
      ))
    }
  </div>
</div>
